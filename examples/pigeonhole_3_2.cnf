c Pigeonhole principle: 3 pigeons, 2 holes
c This is unsatisfiable - you cannot place 3 pigeons in 2 holes
c with at most one pigeon per hole
c
c Variables: xij means pigeon i is in hole j
c x11=1, x12=2, x21=3, x22=4, x31=5, x32=6
c
p cnf 6 10
c Each pigeon must be in some hole
1 2 0
3 4 0
5 6 0
c No two pigeons in hole 1
-1 -3 0
-1 -5 0
-3 -5 0
c No two pigeons in hole 2
-2 -4 0
-2 -6 0
-4 -6 0
c Redundant clause for symmetry breaking
1 3 5 0
