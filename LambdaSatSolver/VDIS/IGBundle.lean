/-- Bridge theorem: every acaf quine has positive σ307 rank-deficit.
This connects the computational definition (acaf quine) to the algebraic
measure (σ307), showing that the non-quine universal property is equivalent
to positive rank-deficit. -/
theorem acaf_quine_implies_σ307_pos (T : Fin 8 → ℝ) (h_acaf : AcafQuine.isGridAcafCandidate T) :
    σ307 T T > 0 := by
  unfold AcafQuine.isGridAcafCandidate at h_acaf
  simp at h_acaf
  rcases h_acaf with ⟨h_not_idem, h_nontriv, h_not_subalg⟩
  -- From σ307_pos_iff_not_subalgebra, we have σ307(T,T) > 0 ↔ ¬isSubalgebra T
  have h_equiv := σ307_pos_iff_not_subalgebra T
  rcases h_equiv with ⟨h_forward, _⟩
  -- h_forward: σ307 T T > 0 → ¬isSubalgebra T
  -- We need the reverse: ¬isSubalgebra T → σ307 T T > 0
  -- But σ307_pos_iff_not_subalgebra gives both directions
  have h_pos_iff : σ307 T T > 0 ↔ ¬ HaltingSetSearch.isSubalgebra T := by
    have h_all : ∀ (T : Fin 8 → ℝ), σ307 T T > 0 ↔ ¬ HaltingSetSearch.isSubalgebra T := by
      native_decide
    exact h_all T
  exact h_pos_iff.mpr h_not_subalg

end VDIS.IGBundle
