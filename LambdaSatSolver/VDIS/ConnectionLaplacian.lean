/-!
## 9. Gluing Defect — Formalization of Σ∞ Section 5

### The Gluing Defect D_glue(s)

From the Σ∞ architecture (thesis §5), the gluing defect measures how far
local sections are from global consistency:

  D_glue(s) = Σ_(i,j) || s_i − T_ij s_j ||²  +  λ_cycle Σ_loops || Hol(loop)·s − s ||²

where:
- s_i are local sections over vertices i
- T_ij are transport maps on overlaps (given by the connection ω)
- Hol(loop) is the holonomy around a loop

For a constant sheaf with flat connection ω and character k, this
simplifies to:

  D_glue(f) = || L_k f ||² + λ_cycle · Σ_loops || k·hol(loop)·f − f ||²

where L_k is the character-twisted connection Laplacian.

### Interpretation

- D_glue(f) = 0 ⟺ f is a global section (consistent across all overlaps)
- D_glue(f) > 0 ⟺ local sections are inconsistent; holonomy reveals the obstruction
- The first term (Laplacian) measures pairwise mismatch
- The second term (holonomy) measures cycle inconsistency

### Connection to Visibility Field

In the Manifold Research programme, the gluing defect connects to the
visibility field g_r(α):
- When D_glue(f) = 0, the backbone is fully visible (no obstruction)
- When D_glue(f) > 0, the backbone is partially hidden (obstruction present)
- The visibility depth r_c is the depth at which D_glue drops below threshold
-/

/-- The gluing defect for a function f : V → ZMod n with connection ω.
  D_glue(f) = || L_k f ||² + λ_cycle · Σ_loops || Hol(loop)·f − f ||²

  The first term is the squared norm of the character-twisted Laplacian.
  The second term is the holonomy mismatch penalty.

  For flat connections (no wrap edges), the holonomy around any loop is 0,
  so the second term vanishes and D_glue(f) = || L_k f ||². -/
noncomputable def gluingDefect (ω : Connection G n) (k : ZMod n) (λ_cycle : ℝ)
    (f : G.V → ZMod n) : ℝ :=
  let Lf := (Matrix.toLin' (laplacianOnCharacter ω k)) (extendToBlock ω f)
  let laplacianTerm := ∑ x : G.V × Fin 2, (Lf x).val.toFloat ^ 2
  -- Holonomy term: for each loop, measure || Hol(loop)·f − f ||²
  -- Placeholder: requires loop enumeration over the graph
  let holonomyTerm := 0.0
  laplacianTerm + λ_cycle * holonomyTerm

/-- The gluing defect vanishes iff the function is in the kernel of L_k
  (for flat connections with no holonomy penalty).

  D_glue(f) = 0 ⟺ L_k f = 0 ⟺ f is a global section. -/
theorem gluingDefect_eq_zero_iff (ω : Connection G n) (k : ZMod n)
    (h_flat : ∀ e : Sym2 G.V, ¬ G.wrap e) (λ_cycle : ℝ) (f : G.V → ZMod n) :
    gluingDefect ω k λ_cycle f = 0 ↔
    (Matrix.toLin' (laplacianOnCharacter ω k)) (extendToBlock ω f) = 0 := by
  constructor
  · intro h
    -- From D_glue = 0, deduce L_k f = 0
    -- D_glue(f) = laplacianTerm + λ_cycle * holonomyTerm
    -- holonomyTerm = 0.0 (placeholder), so D_glue(f) = laplacianTerm
    -- If D_glue(f) = 0, then laplacianTerm = 0
    unfold gluingDefect at h
    -- h: laplacianTerm + λ_cycle * 0.0 = 0
    -- Simplify: laplacianTerm = 0
    have hLaplacianTerm : (∑ x : G.V × Fin 2, ((Matrix.toLin' (laplacianOnCharacter ω k))
      (extendToBlock ω f) x).val.toFloat ^ 2) = 0 := by
      simpa [add_zero] using h
    -- A sum of nonnegative squares is 0 iff each term is 0
    have hEachTermZero : ∀ x : G.V × Fin 2, ((Matrix.toLin' (laplacianOnCharacter ω k))
      (extendToBlock ω f) x).val.toFloat ^ 2 = 0 := by
      have h_nonneg : ∀ x, 0 ≤ ((Matrix.toLin' (laplacianOnCharacter ω k))
        (extendToBlock ω f) x).val.toFloat ^ 2 := fun x => pow_two_nonneg _
      have h_sum_nonneg : 0 ≤ ∑ x : G.V × Fin 2,
        ((Matrix.toLin' (laplacianOnCharacter ω k))
          (extendToBlock ω f) x).val.toFloat ^ 2 :=
        Finset.sum_nonneg h_nonneg
      exact fun x => Finset.sum_eq_zero_iff_of_nonneg h_sum_nonneg |>.mp hLaplacianTerm x (Finset.mem_univ _)
    -- From each squared term = 0, we get L_k f = 0
    ext ⟨x, i⟩
    have h_sq_zero := hEachTermZero (x, i)
    -- h_sq_zero: (val.toFloat)^2 = 0, so val.toFloat = 0
    have h_float_zero : ((Matrix.toLin' (laplacianOnCharacter ω k))
      (extendToBlock ω f) (x, i)).val.toFloat = 0 := by
      nlinarith
    -- val.toFloat = 0 implies val = 0 (since Nat.toFloat is injective on ℕ)
    -- Use the lemma Nat.toFloat_eq_zero_iff or direct reasoning
    have h_val_zero : ((Matrix.toLin' (laplacianOnCharacter ω k))
      (extendToBlock ω f) (x, i)).val = 0 := by
      -- Nat.toFloat is injective: Nat.toFloat a = 0 ↔ a = 0
      -- This holds because Nat.toFloat a = (a : ℝ) for a : ℕ
      have : ((Matrix.toLin' (laplacianOnCharacter ω k))
        (extendToBlock ω f) (x, i)).val.toFloat = 
        (((Matrix.toLin' (laplacianOnCharacter ω k))
          (extendToBlock ω f) (x, i)).val : ℝ) := by
        simp
      rw [this] at h_float_zero
      -- Now h_float_zero: (val : ℝ) = 0
      -- This implies val = 0 (since val is a Nat)
      exact_mod_cast h_float_zero
    -- Now Lf (x,i) = 0 in ZMod n (since val = 0)
    apply ZMod.val_injective
    rw [h_val_zero, ZMod.val_zero]
  · intro h
    -- From L_k f = 0, deduce D_glue = 0
    dsimp [gluingDefect]
    have hLaplacianTerm : (∑ x : G.V × Fin 2, ((Matrix.toLin' (laplacianOnCharacter ω k))
      (extendToBlock ω f) x).val.toFloat ^ 2) = 0 := by
      simp [h]
    simp [hLaplacianTerm]

/-- The gluing defect decomposes into Laplacian and holonomy components.
  D_glue = || L_k f ||² + λ_cycle · H(f)
  where H(f) = Σ_loops || Hol(loop)·f − f ||² is the holonomy mismatch. -/
theorem gluingDefect_decomposition (ω : Connection G n) (k : ZMod n)
    (λ_cycle : ℝ) (f : G.V → ZMod n) :
    gluingDefect ω k λ_cycle f =
    (∑ x : G.V × Fin 2, ((Matrix.toLin' (laplacianOnCharacter ω k))
      (extendToBlock ω f) x).val.toFloat ^ 2) +
    λ_cycle * (∑ loop : G.Walk, 
      -- Holonomy mismatch for each loop
      0.0) := by
  -- Placeholder: holonomy sum requires loop enumeration
  sorry

